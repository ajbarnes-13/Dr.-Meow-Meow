rules_version = '2';

// Controls who can read/write files in Firebase Storage (separate from the MySQL database).
service firebase.storage {
  match /b/{bucket}/o {
    // Pet photos live at pet-photos/<uid>/<petId> -- <uid> is the Firebase Auth id
    // of the pet's owner, so only that logged-in user can upload or overwrite it.
    match /pet-photos/{uid}/{petId} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024 // reject anything over 5MB
                   && request.resource.contentType.matches('image/.*'); // only allow image files
    }

    // Everything else is off-limits by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
